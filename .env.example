# Copy this file to .env (at root or src/agent/services/) and fill in your actual values.
# Never commit real credentials to version control.

# ── API Keys (required) ──────────────────────────────────────────────────────
OPENAI_API_KEY = "your own key"
OPENAI_BASE_URL = 'https://api.openai.com/v1'

SERPAPI_API_KEY = "your own key"

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_API_KEY="your own key"
LANGSMITH_PROJECT="multi-agent project"

# ── Tavily (alternative search, optional) ────────────────────────────────────
TAVILY_API_KEY="your own key"
TAVILY_BASE_URL="https://api.tavily.com"

# ── Pipeline config overrides (all optional, defaults shown) ─────────────────
# LLM
LLM_MODEL="gpt-5-nano"
LLM_TEMPERATURE_STRICT=0.2
LLM_TEMPERATURE_INSIGHTS=0.7
LLM_TEMPERATURE_CONTENT=0.7
EMBEDDING_MODEL="text-embedding-ada-002"

# Vector store
DEFAULT_DB_PATH="./chroma_db"
CHROMA_COLLECTION_NAME="openai_embedding"
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=50
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=50

# Search
SEARCH_LOCATION="global"
SEARCH_GL="global"
SEARCH_HL="en"
SEARCH_NUM_RESULTS=10

# Facebook
# FACEBOOK_API_VERSION=v17.0
# FACEBOOK_TIMEOUT_POST=15
# FACEBOOK_TIMEOUT_GET=10

# Retry policy
RETRY_ATTEMPTS=3
RETRY_WAIT_MIN=1
RETRY_WAIT_MAX=10

# Web loader
MIN_CHUNK_WORD_COUNT=10
WEB_LOADER_MAX_WORKERS=5

# optional
SEARCH_QUERY="AI marketing trends 2025 for small businesses"
LOCAL_PDF_PATH="./llama2.pdf" # just test function
DRY_RUN=true  # if false, then will publish in facebook